generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  school_admin
  teacher
  leader
  member
  expert
  training_teacher
}

enum UserApprovalStatus {
  pending
  approved
}

enum ExpertReviewAssignmentStatus {
  pending
  submitted
  completed
  locked
  timeout
  closed_by_admin
  excluded
}

enum ExpertReviewMaterialKind {
  plan
  ppt
  video
}

enum ExpertReviewPackageStatus {
  configured
  cancelled
  archived
}

enum TaskStatus {
  todo
  doing
  review
  archived
  done
}

enum TaskPriority {
  high
  medium
  low
}

enum DocumentStatus {
  pending
  leader_approved
  approved
  leader_revision
  revision
}

enum DocumentCategory {
  plan
  ppt
  defense
  proof
}

enum NotificationEmailStatus {
  sent
  failed
  skipped
}

enum ReportEvaluationType {
  praise
  improve
  comment
}

enum ProjectReviewStageType {
  online_review
  roadshow
}

enum ProjectMaterialStatus {
  pending
  approved
  rejected
}

enum ReviewDisplaySessionStatus {
  waiting
  scoring
  revealed
  closed
}

enum ReviewDisplaySeatStatus {
  pending
  submitted
  timeout
  closed_by_admin
  excluded
  voided
}

enum ReviewDisplayScreenPhase {
  draw
  presentation
  qa
  scoring
  reveal
  finished
}

enum TrainingRevisionStatus {
  pending
  approved
  rejected
  withdrawn
}

model User {
  id                                String                            @id @default(cuid())
  name                              String
  username                          String                            @unique
  email                             String?                           @unique
  phone                             String?
  password                          String
  role                              Role
  approvalStatus                    UserApprovalStatus                @default(approved)
  approvedAt                        DateTime?
  approvedById                      String?
  teamGroupId                       String?
  emailVerifiedAt                   DateTime?
  college                           String?
  className                         String?
  studentId                         String?
  employeeId                        String?
  avatar                            String
  avatarImagePath                   String?
  responsibility                    String?
  createdAt                         DateTime                          @default(now())
  approvedBy                        User?                             @relation("UserApprovals", fields: [approvedById], references: [id])
  approvedUsers                     User[]                            @relation("UserApprovals")
  teamGroup                         TeamGroup?                        @relation(fields: [teamGroupId], references: [id], onDelete: SetNull)
  tasksAssigned                     Task[]                            @relation("TaskAssignee")
  taskAssignments                   TaskAssignment[]                  @relation("TaskAssignmentAssignee")
  tasksCreated                      Task[]                            @relation("TaskCreator")
  tasksReviewed                     Task[]                            @relation("TaskReviewer")
  taskAttachments                   TaskAttachment[]                  @relation("TaskAttachmentUploader")
  reports                           Report[]
  announcements                     Announcement[]
  events                            Event[]                           @relation("EventCreator")
  expertFeedbacks                   ExpertFeedback[]                  @relation("ExpertFeedbackCreator")
  documents                         Document[]                        @relation("DocumentOwner")
  documentEdits                     DocumentVersion[]                 @relation("DocumentVersionUploader")
  notifications                     Notification[]                    @relation("NotificationRecipient")
  sentNotifications                 Notification[]                    @relation("NotificationSender")
  aiPermission                      AiPermission?
  aiConversations                   AiConversation[]
  dingTalkAccount                   DingTalkAccount?
  pushDevices                       PushDevice[]
  expertProfilesCreated             ExpertProfile[]                   @relation("ExpertProfileCreator")
  expertProfile                     ExpertProfile?                    @relation("ExpertProfileAccount")
  expertReviewPackages              ExpertReviewPackage[]             @relation("ExpertReviewPackageCreator")
  expertAssignments                 ExpertReviewAssignment[]          @relation("ExpertAssignmentUser")
  expertScores                      ExpertReviewScore[]               @relation("ExpertScoreReviewer")
  expertReviewGuestTokens           ExpertReviewGuestToken[]          @relation("ExpertReviewGuestTokenExpert")
  createdExpertReviewGuestTokens    ExpertReviewGuestToken[]          @relation("ExpertReviewGuestTokenCreator")
  reviewDisplaySessions             ReviewDisplaySession[]            @relation("ReviewDisplaySessionCreator")
  reviewDisplaySeats                ReviewDisplaySeat[]               @relation("ReviewDisplaySeatExpert")
  voidedReviewDisplaySeats          ReviewDisplaySeat[]               @relation("ReviewDisplaySeatVoider")
  trainingQuestions                 TrainingQuestion[]                @relation("TrainingQuestionCreator")
  trainingSessions                  TrainingSession[]                 @relation("TrainingSessionCreator")
  aiTrainingSessions                AiTrainingSession[]               @relation("AiTrainingSessionCreator")
  trainingRevisionSubmissions       TrainingQuestionRevisionRequest[] @relation("TrainingRevisionSubmitter")
  trainingRevisionReviews           TrainingQuestionRevisionRequest[] @relation("TrainingRevisionReviewer")
  teacherTrainingCohorts            TeacherTrainingCohort[]           @relation("TeacherTrainingCohortCreator")
  teacherTrainingCourseItems        TeacherTrainingCourseSession[]    @relation("TeacherTrainingCourseSessionCreator")
  teacherTrainingAccounts           TeacherTrainingParticipant[]      @relation("TeacherTrainingParticipantAccount")
  teacherTrainingMarks              TeacherTrainingAttendance[]       @relation("TeacherTrainingAttendanceMarker")
  teacherTrainingCheckIns           TeacherTrainingCheckInTask[]      @relation("TeacherTrainingCheckInTaskCreator")
  teacherTrainingLeaveFlows         TeacherTrainingLeaveFlow[]        @relation("TeacherTrainingLeaveFlowCreator")
  teacherTrainingLeaveSubmits       TeacherTrainingLeaveRequest[]     @relation("TeacherTrainingLeaveRequestSubmitter")
  teacherTrainingLeaveReviews       TeacherTrainingLeaveApproval[]    @relation("TeacherTrainingLeaveApprovalReviewer")
  teacherTrainingManagedCohorts     TeacherTrainingCohortManager[]    @relation("TeacherTrainingCohortManagerUser")
  teacherTrainingManagerAssignments TeacherTrainingCohortManager[]    @relation("TeacherTrainingCohortManagerCreator")
  teacherTrainingTasks              TeacherTrainingTask[]             @relation("TeacherTrainingTaskCreator")
  teacherTrainingSubmissions        TeacherTrainingSubmission[]       @relation("TeacherTrainingSubmissionSubmitter")
  passwordResetTokens               PasswordResetToken[]
  reportEvaluations                 ReportEvaluation[]                @relation("ReportEvaluationCreator")
  projectReviewStages               ProjectReviewStage[]              @relation("ProjectReviewStageCreator")
  projectMaterialsSubmitted         ProjectMaterialSubmission[]       @relation("ProjectMaterialSubmitter")
  projectMaterialsApproved          ProjectMaterialSubmission[]       @relation("ProjectMaterialApprover")
  projectMaterialsRejected          ProjectMaterialSubmission[]       @relation("ProjectMaterialRejecter")
}

model DingTalkAccount {
  id           String   @id @default(cuid())
  userId       String   @unique
  corpId       String
  userIdInCorp String
  unionId      String?
  name         String?
  boundAt      DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([corpId, userIdInCorp])
  @@index([unionId])
  @@index([updatedAt])
}

model EmailVerificationCode {
  id         String    @id @default(cuid())
  email      String
  purpose    String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([email, purpose, createdAt])
  @@index([expiresAt])
}

model AiPermission {
  id        String    @id @default(cuid())
  userId    String    @unique
  isEnabled Boolean   @default(false)
  maxCount  Int?
  usedCount Int       @default(0)
  resetAt   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([isEnabled, updatedAt])
}

model AiConversation {
  id             String   @id @default(cuid())
  userId         String
  conversationId String   @unique
  title          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
  @@index([userId, updatedAt])
}

model PushDevice {
  id         String   @id @default(cuid())
  userId     String
  platform   String
  pushToken  String
  deviceName String?
  appVersion String?
  isActive   Boolean  @default(true)
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ExpertProfile {
  id              String   @id @default(cuid())
  name            String
  phone           String?
  email           String?
  organization    String?
  title           String?
  specialtyTags   String   @default("[]")
  specialtyTracks String   @default("[]")
  specialtyText   String?
  notes           String?
  linkedUserId    String?  @unique
  createdById     String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  linkedUser      User?    @relation("ExpertProfileAccount", fields: [linkedUserId], references: [id], onDelete: SetNull)
  createdBy       User     @relation("ExpertProfileCreator", fields: [createdById], references: [id])

  @@index([name, organization])
  @@index([createdAt])
}

model TeamGroup {
  id                         String                            @id @default(cuid())
  name                       String                            @unique
  description                String?
  createdAt                  DateTime                          @default(now())
  members                    User[]
  tasks                      Task[]
  announcements              Announcement[]
  events                     Event[]
  expertFeedbacks            ExpertFeedback[]
  expertReviewPackages       ExpertReviewPackage[]
  trainingQuestions          TrainingQuestion[]
  trainingSessions           TrainingSession[]
  aiTrainingSessions         AiTrainingSession[]
  trainingRevisionRequests   TrainingQuestionRevisionRequest[]
  projectReviewStages        ProjectReviewStage[]
  projectMaterialSubmissions ProjectMaterialSubmission[]
  documents                  Document[]
}

model Task {
  id               String           @id @default(cuid())
  title            String
  status           TaskStatus
  priority         TaskPriority
  assigneeId       String?
  creatorId        String
  reviewerId       String?
  teamGroupId      String?
  sourceDocumentId String?
  dueDate          DateTime
  acceptedAt       DateTime?
  submittedAt      DateTime?
  archivedAt       DateTime?
  rejectedAt       DateTime?
  rejectionReason  String?
  completionNote   String?
  createdAt        DateTime         @default(now())
  assignee         User?            @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  creator          User             @relation("TaskCreator", fields: [creatorId], references: [id])
  reviewer         User?            @relation("TaskReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  teamGroup        TeamGroup?       @relation(fields: [teamGroupId], references: [id], onDelete: SetNull)
  attachments      TaskAttachment[]
  assignments      TaskAssignment[]

  @@index([teamGroupId, status, dueDate])
  @@index([assigneeId, status])
  @@index([reviewerId, status])
  @@index([sourceDocumentId, status])
}

model TaskAssignment {
  id              String    @id @default(cuid())
  taskId          String
  assigneeId      String
  acceptedAt      DateTime?
  submittedAt     DateTime?
  archivedAt      DateTime?
  rejectedAt      DateTime?
  rejectionReason String?
  completionNote  String?
  createdAt       DateTime  @default(now())
  task            Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  assignee        User      @relation("TaskAssignmentAssignee", fields: [assigneeId], references: [id])

  @@unique([taskId, assigneeId])
  @@index([assigneeId, submittedAt])
  @@index([taskId, submittedAt])
}

model TaskAttachment {
  id         String   @id @default(cuid())
  taskId     String
  uploaderId String
  fileName   String
  filePath   String
  fileSize   Int
  mimeType   String
  uploadedAt DateTime @default(now())
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploader   User     @relation("TaskAttachmentUploader", fields: [uploaderId], references: [id])

  @@index([taskId, uploadedAt])
}

model Report {
  id           String             @id @default(cuid())
  userId       String
  date         String
  summary      String
  nextPlan     String
  attachment   String?
  praiseCount  Int                @default(0)
  improveCount Int                @default(0)
  commentCount Int                @default(0)
  submittedAt  DateTime           @default(now())
  user         User               @relation(fields: [userId], references: [id])
  evaluations  ReportEvaluation[]

  @@unique([userId, date])
}

model ReportEvaluation {
  id            String               @id @default(cuid())
  reportId      String
  evaluatorId   String
  evaluatorRole Role
  type          ReportEvaluationType
  content       String?
  isRead        Boolean              @default(false)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  revokedAt     DateTime?
  report        Report               @relation(fields: [reportId], references: [id], onDelete: Cascade)
  evaluator     User                 @relation("ReportEvaluationCreator", fields: [evaluatorId], references: [id])

  @@index([reportId])
  @@index([evaluatorId])
  @@index([reportId, isRead])
}

model Announcement {
  id          String     @id @default(cuid())
  title       String
  detail      String
  authorId    String
  teamGroupId String?
  createdAt   DateTime   @default(now())
  author      User       @relation(fields: [authorId], references: [id])
  teamGroup   TeamGroup? @relation(fields: [teamGroupId], references: [id], onDelete: SetNull)

  @@index([teamGroupId, createdAt])
}

model Event {
  id          String     @id @default(cuid())
  title       String
  dateTime    DateTime
  type        String
  description String
  creatorId   String?
  teamGroupId String?
  createdAt   DateTime   @default(now())
  creator     User?      @relation("EventCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  teamGroup   TeamGroup? @relation(fields: [teamGroupId], references: [id], onDelete: SetNull)

  @@index([teamGroupId, dateTime])
}

model ExpertFeedback {
  id              String             @id @default(cuid())
  date            String
  expert          String
  topic           String
  format          String
  summary         String
  nextAction      String
  attachments     String
  createdById     String?
  teamGroupId     String?
  createdAt       DateTime           @default(now())
  createdBy       User?              @relation("ExpertFeedbackCreator", fields: [createdById], references: [id], onDelete: SetNull)
  teamGroup       TeamGroup?         @relation(fields: [teamGroupId], references: [id], onDelete: SetNull)
  attachmentFiles ExpertAttachment[]

  @@index([teamGroupId, date, createdAt])
}

model ExpertAttachment {
  id         String         @id @default(cuid())
  feedbackId String
  fileName   String
  filePath   String
  fileSize   Int
  mimeType   String
  uploadedAt DateTime       @default(now())
  feedback   ExpertFeedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
}

model Document {
  id             String            @id @default(cuid())
  name           String
  category       DocumentCategory
  ownerId        String
  teamGroupId    String?
  status         DocumentStatus
  comment        String?
  currentVersion String
  createdAt      DateTime          @default(now())
  owner          User              @relation("DocumentOwner", fields: [ownerId], references: [id])
  teamGroup      TeamGroup?        @relation(fields: [teamGroupId], references: [id], onDelete: SetNull)
  versions       DocumentVersion[]

  @@index([teamGroupId])
}

model DocumentVersion {
  id         String   @id @default(cuid())
  documentId String
  version    String
  uploadedAt DateTime @default(now())
  uploaderId String
  note       String
  fileName   String
  filePath   String
  fileSize   Int
  mimeType   String
  document   Document @relation(fields: [documentId], references: [id])
  uploader   User     @relation("DocumentVersionUploader", fields: [uploaderId], references: [id])
}

model Notification {
  id          String                   @id @default(cuid())
  userId      String
  senderId    String?
  documentId  String?
  title       String
  detail      String
  type        String
  targetTab   String?
  relatedId   String?
  isRead      Boolean                  @default(false)
  readAt      DateTime?
  emailStatus NotificationEmailStatus?
  emailError  String?
  emailSentAt DateTime?
  createdAt   DateTime                 @default(now())
  user        User                     @relation("NotificationRecipient", fields: [userId], references: [id])
  sender      User?                    @relation("NotificationSender", fields: [senderId], references: [id])

  @@index([userId, isRead, createdAt])
  @@index([senderId, type, createdAt])
}

model EmailReminderSetting {
  id                          String   @id
  taskAssignmentEnabled       Boolean  @default(true)
  taskReviewEnabled           Boolean  @default(true)
  announcementEnabled         Boolean  @default(true)
  directReminderEnabled       Boolean  @default(true)
  documentReviewEnabled       Boolean  @default(true)
  teacherTrainingLeaveEnabled Boolean  @default(true)
  reportSubmitEnabled         Boolean  @default(true)
  dailyReportMissingEnabled   Boolean  @default(true)
  dailyReportHour             Int      @default(20)
  updatedAt                   DateTime @updatedAt
}

model ProjectReviewStage {
  id          String                      @id @default(cuid())
  name        String
  type        ProjectReviewStageType
  description String?
  isOpen      Boolean                     @default(false)
  startAt     DateTime?
  deadline    DateTime?
  createdById String
  teamGroupId String?
  createdAt   DateTime                    @default(now())
  updatedAt   DateTime                    @updatedAt
  creator     User                        @relation("ProjectReviewStageCreator", fields: [createdById], references: [id])
  teamGroup   TeamGroup?                  @relation(fields: [teamGroupId], references: [id], onDelete: SetNull)
  submissions ProjectMaterialSubmission[]
  packages    ExpertReviewPackage[]
  guestTokens ExpertReviewGuestToken[]

  @@index([isOpen, deadline])
  @@index([teamGroupId, createdAt])
}

model ProjectMaterialSubmission {
  id            String                @id @default(cuid())
  stageId       String
  teamGroupId   String
  submittedById String
  title         String
  fileName      String
  filePath      String
  fileSize      Int
  mimeType      String
  status        ProjectMaterialStatus @default(pending)
  approvedById  String?
  approvedAt    DateTime?
  rejectedById  String?
  rejectedAt    DateTime?
  rejectReason  String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  stage         ProjectReviewStage    @relation(fields: [stageId], references: [id], onDelete: Cascade)
  teamGroup     TeamGroup             @relation(fields: [teamGroupId], references: [id], onDelete: Cascade)
  submitter     User                  @relation("ProjectMaterialSubmitter", fields: [submittedById], references: [id])
  approver      User?                 @relation("ProjectMaterialApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  rejecter      User?                 @relation("ProjectMaterialRejecter", fields: [rejectedById], references: [id], onDelete: SetNull)

  @@index([stageId, status, createdAt])
  @@index([teamGroupId, stageId, status])
  @@index([submittedById, createdAt])
}

model ExpertReviewPackage {
  id                   String                       @id @default(cuid())
  targetName           String
  roundLabel           String?
  overview             String?
  status               ExpertReviewPackageStatus    @default(configured)
  startAt              DateTime?
  deadline             DateTime?
  dropHighestCount     Int                          @default(0)
  dropLowestCount      Int                          @default(0)
  createdById          String
  teamGroupId          String?
  projectReviewStageId String?
  createdAt            DateTime                     @default(now())
  creator              User                         @relation("ExpertReviewPackageCreator", fields: [createdById], references: [id])
  teamGroup            TeamGroup?                   @relation(fields: [teamGroupId], references: [id], onDelete: SetNull)
  projectReviewStage   ProjectReviewStage?          @relation(fields: [projectReviewStageId], references: [id], onDelete: SetNull)
  materials            ExpertReviewMaterial[]
  assignments          ExpertReviewAssignment[]
  displaySessions      ReviewDisplaySession[]
  projectOrders        ReviewDisplayProjectOrder[]
  teamDrawTokens       ReviewDisplayTeamDrawToken[]

  @@index([teamGroupId, createdAt])
  @@index([projectReviewStageId, createdAt])
  @@index([projectReviewStageId, teamGroupId, status])
  @@index([status, createdAt])
}

model ExpertReviewAssignment {
  id            String                       @id @default(cuid())
  packageId     String
  expertUserId  String
  status        ExpertReviewAssignmentStatus @default(pending)
  createdAt     DateTime                     @default(now())
  reviewPackage ExpertReviewPackage          @relation(fields: [packageId], references: [id], onDelete: Cascade)
  expertUser    User                         @relation("ExpertAssignmentUser", fields: [expertUserId], references: [id])
  score         ExpertReviewScore?
  displaySeats  ReviewDisplaySeat[]

  @@unique([packageId, expertUserId])
  @@index([expertUserId, status, createdAt])
}

model ExpertReviewMaterial {
  id            String                   @id @default(cuid())
  packageId     String
  kind          ExpertReviewMaterialKind
  name          String
  fileName      String
  filePath      String
  fileSize      Int
  mimeType      String
  uploadedAt    DateTime                 @default(now())
  reviewPackage ExpertReviewPackage      @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@unique([packageId, kind])
  @@index([packageId, kind])
}

model ExpertReviewScore {
  id                  String                 @id @default(cuid())
  assignmentId        String                 @unique
  reviewerId          String
  scorePersonalGrowth Int
  scoreInnovation     Int
  scoreIndustry       Int
  scoreTeamwork       Int
  totalScore          Int
  commentTotal        String
  submittedAt         DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  lockedAt            DateTime?
  assignment          ExpertReviewAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  reviewer            User                   @relation("ExpertScoreReviewer", fields: [reviewerId], references: [id])
}

model ExpertReviewScoreHistory {
  id           String   @id @default(cuid())
  packageId    String
  teamGroupId  String?
  assignmentId String
  reviewerId   String?
  snapshot     String
  resetById    String
  resetReason  String
  createdAt    DateTime @default(now())

  @@index([packageId, createdAt])
  @@index([teamGroupId, createdAt])
  @@index([assignmentId, createdAt])
  @@index([resetById, createdAt])
}

model ExpertReviewGuestToken {
  id                   String             @id @default(cuid())
  expertUserId         String
  projectReviewStageId String
  tokenHash            String             @unique
  tokenExpiresAt       DateTime
  revokedAt            DateTime?
  lastUsedAt           DateTime?
  createdById          String
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  expertUser           User               @relation("ExpertReviewGuestTokenExpert", fields: [expertUserId], references: [id], onDelete: Cascade)
  projectReviewStage   ProjectReviewStage @relation(fields: [projectReviewStageId], references: [id], onDelete: Cascade)
  creator              User               @relation("ExpertReviewGuestTokenCreator", fields: [createdById], references: [id])

  @@unique([expertUserId, projectReviewStageId])
  @@index([projectReviewStageId, revokedAt])
  @@index([expertUserId, tokenExpiresAt])
}

model AuditLog {
  id           String   @id @default(cuid())
  operatorId   String
  operatorRole Role
  action       String
  objectType   String
  objectId     String
  teamGroupId  String?
  beforeState  String?
  afterState   String?
  reason       String?
  metadata     String?
  createdAt    DateTime @default(now())

  @@index([operatorId, createdAt])
  @@index([operatorRole, createdAt])
  @@index([action, createdAt])
  @@index([objectType, objectId, createdAt])
  @@index([teamGroupId, createdAt])
}

model ReviewDisplaySession {
  id                     String                       @id @default(cuid())
  packageId              String
  tokenHash              String                       @unique
  startsAt               DateTime?
  tokenExpiresAt         DateTime
  countdownSeconds       Int                          @default(60)
  dropHighestCount       Int                          @default(0)
  dropLowestCount        Int                          @default(0)
  status                 ReviewDisplaySessionStatus   @default(waiting)
  startedAt              DateTime?
  endedAt                DateTime?
  screenPhase            ReviewDisplayScreenPhase     @default(draw)
  currentPackageId       String?
  presentationSeconds    Int                          @default(480)
  qaSeconds              Int                          @default(420)
  scoringSeconds         Int                          @default(60)
  scoringEnabled         Boolean                      @default(true)
  showScoresOnScreen     Boolean                      @default(false)
  showFinalScoreOnScreen Boolean                      @default(false)
  showRankingOnScreen    Boolean                      @default(false)
  selfDrawEnabled        Boolean                      @default(false)
  teamDrawEnabled        Boolean                      @default(false)
  teamDrawQueue          String?
  phaseStartedAt         DateTime?
  revealStartedAt        DateTime?
  createdById            String
  createdAt              DateTime                     @default(now())
  updatedAt              DateTime                     @updatedAt
  reviewPackage          ExpertReviewPackage          @relation(fields: [packageId], references: [id], onDelete: Cascade)
  creator                User                         @relation("ReviewDisplaySessionCreator", fields: [createdById], references: [id])
  seats                  ReviewDisplaySeat[]
  projectOrders          ReviewDisplayProjectOrder[]
  teamDrawTokens         ReviewDisplayTeamDrawToken[]

  @@index([packageId, status])
  @@index([tokenExpiresAt])
}

model ReviewDisplaySeat {
  id           String                  @id @default(cuid())
  sessionId    String
  assignmentId String
  expertUserId String
  seatNo       Int
  displayName  String
  status       ReviewDisplaySeatStatus @default(pending)
  voidedAt     DateTime?
  voidedById   String?
  voidReason   String?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  session      ReviewDisplaySession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  assignment   ExpertReviewAssignment  @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  expertUser   User                    @relation("ReviewDisplaySeatExpert", fields: [expertUserId], references: [id])
  voidedBy     User?                   @relation("ReviewDisplaySeatVoider", fields: [voidedById], references: [id], onDelete: SetNull)

  @@unique([sessionId, assignmentId])
  @@unique([sessionId, seatNo])
  @@index([expertUserId, status])
}

model ReviewDisplayProjectOrder {
  id                 String               @id @default(cuid())
  sessionId          String
  packageId          String
  orderIndex         Int
  groupName          String?
  groupIndex         Int                  @default(0)
  groupSlotIndex     Int                  @default(0)
  selfDrawnAt        DateTime?
  revealedAt         DateTime?
  finalScoreCents    Int?
  finalScoreText     String?
  effectiveSeatCount Int?
  submittedSeatCount Int?
  droppedSeatNos     String?
  dropHighestCount   Int?
  dropLowestCount    Int?
  scoreLockedAt      DateTime?
  createdAt          DateTime             @default(now())
  session            ReviewDisplaySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  reviewPackage      ExpertReviewPackage  @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@unique([sessionId, packageId])
  @@unique([sessionId, orderIndex])
  @@index([sessionId, orderIndex])
}

model ReviewDisplayTeamDrawToken {
  id             String               @id @default(cuid())
  sessionId      String
  packageId      String
  tokenHash      String               @unique
  tokenExpiresAt DateTime
  usedAt         DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  session        ReviewDisplaySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  reviewPackage  ExpertReviewPackage  @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@unique([sessionId, packageId])
  @@index([sessionId, usedAt])
  @@index([packageId])
  @@index([tokenExpiresAt])
}

model TrainingQuestion {
  id               String                            @id @default(cuid())
  category         String
  question         String
  answerPoints     String
  createdById      String
  teamGroupId      String?
  createdAt        DateTime                          @default(now())
  updatedAt        DateTime                          @updatedAt
  createdBy        User                              @relation("TrainingQuestionCreator", fields: [createdById], references: [id], onDelete: Cascade)
  teamGroup        TeamGroup?                        @relation(fields: [teamGroupId], references: [id], onDelete: SetNull)
  aiTrainingTurns  AiTrainingTurn[]
  revisionRequests TrainingQuestionRevisionRequest[]

  @@index([category, createdAt])
  @@index([createdById, createdAt])
  @@index([teamGroupId, createdAt])
}

model TrainingSession {
  id              String     @id @default(cuid())
  title           String?
  durationSeconds Int
  overtimeSeconds Int        @default(0)
  qaTotal         Int        @default(0)
  qaHit           Int        @default(0)
  notes           String?
  createdById     String
  teamGroupId     String?
  createdAt       DateTime   @default(now())
  createdBy       User       @relation("TrainingSessionCreator", fields: [createdById], references: [id], onDelete: Cascade)
  teamGroup       TeamGroup? @relation(fields: [teamGroupId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([createdById, createdAt])
  @@index([teamGroupId, createdAt])
}

model AiTrainingSession {
  id          String           @id @default(cuid())
  createdById String
  teamGroupId String?
  status      String           @default("active")
  startedAt   DateTime         @default(now())
  completedAt DateTime?
  summaryJson String?
  createdBy   User             @relation("AiTrainingSessionCreator", fields: [createdById], references: [id], onDelete: Cascade)
  teamGroup   TeamGroup?       @relation(fields: [teamGroupId], references: [id], onDelete: SetNull)
  turns       AiTrainingTurn[]

  @@index([createdById, startedAt])
  @@index([teamGroupId, startedAt])
}

model AiTrainingTurn {
  id                   String              @id @default(cuid())
  sessionId            String
  questionId           String?
  turnNumber           Int
  prompt               String
  questionText         String
  answerPointsSnapshot String
  createdAt            DateTime            @default(now())
  session              AiTrainingSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question             TrainingQuestion?   @relation(fields: [questionId], references: [id], onDelete: SetNull)
  attempts             AiTrainingAttempt[]

  @@unique([sessionId, turnNumber])
  @@index([questionId, createdAt])
}

model AiTrainingAttempt {
  id               String                            @id @default(cuid())
  turnId           String
  attemptNumber    Int
  answerText       String
  answerHash       String
  score            Int
  feedbackJson     String
  createdAt        DateTime                          @default(now())
  turn             AiTrainingTurn                    @relation(fields: [turnId], references: [id], onDelete: Cascade)
  revisionRequests TrainingQuestionRevisionRequest[]

  @@unique([turnId, attemptNumber])
  @@unique([turnId, answerHash])
  @@index([createdAt])
}

model TrainingQuestionRevisionRequest {
  id                   String                 @id @default(cuid())
  questionId           String
  attemptId            String
  submittedById        String
  teamGroupId          String?
  status               TrainingRevisionStatus @default(pending)
  originalAnswerPoints String
  proposedAnswerPoints String
  reason               String
  reviewedById         String?
  reviewComment        String?
  reviewedAt           DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  question             TrainingQuestion       @relation(fields: [questionId], references: [id], onDelete: Cascade)
  attempt              AiTrainingAttempt      @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  submittedBy          User                   @relation("TrainingRevisionSubmitter", fields: [submittedById], references: [id], onDelete: Cascade)
  reviewedBy           User?                  @relation("TrainingRevisionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  teamGroup            TeamGroup?             @relation(fields: [teamGroupId], references: [id], onDelete: SetNull)

  @@index([questionId, status, createdAt])
  @@index([submittedById, status, createdAt])
  @@index([teamGroupId, status, createdAt])
}

model TeacherTrainingCohort {
  id             String                         @id @default(cuid())
  title          String
  location       String?
  startDate      String
  endDate        String
  description    String?
  createdById    String
  deletedAt      DateTime?
  deletedById    String?
  deletedByName  String?
  createdAt      DateTime                       @default(now())
  updatedAt      DateTime                       @updatedAt
  creator        User                           @relation("TeacherTrainingCohortCreator", fields: [createdById], references: [id])
  courseSessions TeacherTrainingCourseSession[]
  participants   TeacherTrainingParticipant[]
  attendances    TeacherTrainingAttendance[]
  checkInTasks   TeacherTrainingCheckInTask[]
  leaveFlow      TeacherTrainingLeaveFlow?
  leaveRequests  TeacherTrainingLeaveRequest[]
  managers       TeacherTrainingCohortManager[]
  tasks          TeacherTrainingTask[]

  @@index([startDate, createdAt])
  @@index([createdById, createdAt])
  @@index([deletedAt])
}

model TeacherTrainingCohortManager {
  id          String                @id @default(cuid())
  cohortId    String
  userId      String
  title       String                @default("班主任")
  createdById String
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  cohort      TeacherTrainingCohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  user        User                  @relation("TeacherTrainingCohortManagerUser", fields: [userId], references: [id], onDelete: Cascade)
  createdBy   User                  @relation("TeacherTrainingCohortManagerCreator", fields: [createdById], references: [id])

  @@unique([cohortId, userId])
  @@index([userId, createdAt])
  @@index([createdById, createdAt])
}

model TeacherTrainingCourseSession {
  id            String                       @id @default(cuid())
  cohortId      String
  title         String
  courseDate    String
  startTime     String?
  endTime       String?
  location      String?
  instructor    String?
  description   String?
  createdById   String
  deletedAt     DateTime?
  deletedById   String?
  deletedByName String?
  createdAt     DateTime                     @default(now())
  updatedAt     DateTime                     @updatedAt
  cohort        TeacherTrainingCohort        @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  creator       User                         @relation("TeacherTrainingCourseSessionCreator", fields: [createdById], references: [id])
  checkInTasks  TeacherTrainingCheckInTask[]

  @@index([cohortId, courseDate, startTime])
  @@index([createdById, createdAt])
  @@index([deletedAt])
}

model TeacherTrainingParticipant {
  id             String                         @id @default(cuid())
  cohortId       String
  name           String
  organization   String
  phone          String?
  groupName      String?
  accountUserId  String?
  extraInfo      String?
  note           String?
  createdAt      DateTime                       @default(now())
  updatedAt      DateTime                       @updatedAt
  cohort         TeacherTrainingCohort          @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  accountUser    User?                          @relation("TeacherTrainingParticipantAccount", fields: [accountUserId], references: [id], onDelete: SetNull)
  attendances    TeacherTrainingAttendance[]
  checkInRecords TeacherTrainingCheckInRecord[]
  leaveRequests  TeacherTrainingLeaveRequest[]
  submissions    TeacherTrainingSubmission[]

  @@index([cohortId, name])
  @@index([accountUserId])
}

model TeacherTrainingCheckInTask {
  id              String                         @id @default(cuid())
  cohortId        String
  courseSessionId String?
  title           String
  signDate        String
  startTime       String?
  endTime         String?
  locationName    String?
  latitude        Float?
  longitude       Float?
  radiusMeters    Int                            @default(300)
  isActive        Boolean                        @default(true)
  createdById     String
  deletedAt       DateTime?
  deletedById     String?
  deletedByName   String?
  createdAt       DateTime                       @default(now())
  updatedAt       DateTime                       @updatedAt
  cohort          TeacherTrainingCohort          @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  courseSession   TeacherTrainingCourseSession?  @relation(fields: [courseSessionId], references: [id], onDelete: SetNull)
  creator         User                           @relation("TeacherTrainingCheckInTaskCreator", fields: [createdById], references: [id])
  records         TeacherTrainingCheckInRecord[]

  @@index([cohortId, signDate, createdAt])
  @@index([courseSessionId])
  @@index([createdById, createdAt])
  @@index([deletedAt])
}

model TeacherTrainingCheckInRecord {
  id             String                     @id @default(cuid())
  checkInTaskId  String
  participantId  String
  latitude       Float?
  longitude      Float?
  accuracy       Float?
  distanceMeters Float?
  status         String                     @default("valid")
  note           String?
  signedAt       DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt
  checkInTask    TeacherTrainingCheckInTask @relation(fields: [checkInTaskId], references: [id], onDelete: Cascade)
  participant    TeacherTrainingParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([checkInTaskId, participantId])
  @@index([participantId, signedAt])
}

model TeacherTrainingLeaveFlow {
  id            String                @id @default(cuid())
  cohortId      String                @unique
  approvalSteps String                @default("[]")
  isEnabled     Boolean               @default(true)
  createdById   String
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  cohort        TeacherTrainingCohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  creator       User                  @relation("TeacherTrainingLeaveFlowCreator", fields: [createdById], references: [id])

  @@index([createdById, createdAt])
}

model TeacherTrainingLeaveRequest {
  id                    String                         @id @default(cuid())
  cohortId              String
  participantId         String
  submittedById         String
  startDate             String
  endDate               String
  startTime             String?
  endTime               String?
  sessionLabel          String?
  reason                String
  status                String                         @default("pending")
  currentStepIndex      Int                            @default(0)
  approvalStepsSnapshot String                         @default("[]")
  submittedAt           DateTime                       @default(now())
  completedAt           DateTime?
  updatedAt             DateTime                       @updatedAt
  cohort                TeacherTrainingCohort          @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  participant           TeacherTrainingParticipant     @relation(fields: [participantId], references: [id], onDelete: Cascade)
  submittedBy           User                           @relation("TeacherTrainingLeaveRequestSubmitter", fields: [submittedById], references: [id])
  approvals             TeacherTrainingLeaveApproval[]

  @@index([cohortId, status, submittedAt])
  @@index([participantId, submittedAt])
  @@index([submittedById, submittedAt])
}

model TeacherTrainingLeaveApproval {
  id             String                      @id @default(cuid())
  leaveRequestId String
  stepKey        String
  stepName       String
  stepIndex      Int
  approverId     String
  decision       String
  comment        String?
  reviewedAt     DateTime                    @default(now())
  leaveRequest   TeacherTrainingLeaveRequest @relation(fields: [leaveRequestId], references: [id], onDelete: Cascade)
  approver       User                        @relation("TeacherTrainingLeaveApprovalReviewer", fields: [approverId], references: [id])

  @@unique([leaveRequestId, stepKey, approverId])
  @@index([approverId, reviewedAt])
}

model TeacherTrainingAttendance {
  id            String                     @id @default(cuid())
  cohortId      String
  participantId String
  sessionDate   String
  sessionLabel  String
  status        String
  note          String?
  markedById    String
  markedAt      DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt
  cohort        TeacherTrainingCohort      @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  participant   TeacherTrainingParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  markedBy      User                       @relation("TeacherTrainingAttendanceMarker", fields: [markedById], references: [id])

  @@unique([participantId, sessionDate, sessionLabel])
  @@index([cohortId, sessionDate, sessionLabel])
  @@index([markedById, markedAt])
}

model TeacherTrainingTask {
  id                String                      @id @default(cuid())
  cohortId          String
  title             String
  description       String
  dueDate           String?
  requireAttachment Boolean                     @default(false)
  createdById       String
  deletedAt         DateTime?
  deletedById       String?
  deletedByName     String?
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt
  cohort            TeacherTrainingCohort       @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  creator           User                        @relation("TeacherTrainingTaskCreator", fields: [createdById], references: [id])
  submissions       TeacherTrainingSubmission[]

  @@index([cohortId, dueDate])
  @@index([createdById, createdAt])
  @@index([deletedAt])
}

model TeacherTrainingSubmission {
  id            String                     @id @default(cuid())
  taskId        String
  participantId String
  content       String
  attachment    String?
  status        String                     @default("submitted")
  submittedById String
  submittedAt   DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt
  task          TeacherTrainingTask        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  participant   TeacherTrainingParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  submittedBy   User                       @relation("TeacherTrainingSubmissionSubmitter", fields: [submittedById], references: [id])

  @@unique([taskId, participantId])
  @@index([participantId, submittedAt])
  @@index([submittedById, submittedAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}
